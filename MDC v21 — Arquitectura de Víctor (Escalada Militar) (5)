{"cells":[{"cell_type":"code","source":"# -*- coding: utf-8 -*-\n\"\"\"\n==============================================================================\n  MDC v21 — EVOLUCIÓ MILITAR DE LA v20 (Respectant el flux de Víctor)\n  Arquitectura: Criba · K-sweep √N Paral·lel · Bisecció ΔΦ Escalada\n==============================================================================\n  AUTOR : Víctor Manzanares Alberola\n  \n  MANTENIM L'ESTRUCTURA QUE FUNCIONA:\n    F0 · Criba roda ràpida (factors asimètrics).\n    F1 · K-sweep √N (factors equilibrats - Paral·lelitzat per a Colab).\n    F2 · Bisecció ΔΦ sobre la zona central (Oracle de Fase amb Coma Fixa).\n==============================================================================\n\"\"\"\n\nimport math\nimport time\nfrom multiprocessing import Pool, cpu_count\n\n# ============================================================================\n#  MOTOR D'ALTA RESOLUCIÓ (Per a 4096 / 8192 bits)\n# ============================================================================\n# Escalem per 10^P per a simular decimals amb sencers (ordre de magnitud > N)\nPRECISIO_P = 2000  \nESCALA = 10 ** PRECISIO_P\nMITJA_ESCALA = ESCALA // 2\n\n# Paràmetres globals de la v20 de Víctor\nLIM_CRIBA = 2_000_000\nLIM_KSWEEP_TOTAL = 4_000_000  # Capacitat total combinada dels nuclis\n\n# ============================================================================\n#  BLOC 1 — ARITMÈTICA ESCALADA (Sencers BigInt)\n# ============================================================================\n\ndef d_scaled(m: int, N: int) -> int:\n    \"\"\"Funció d'ona en coma fixa: d(m) = ((N % D) * ESCALA) // D - 0.5*ESCALA\"\"\"\n    D = 2 * (2 * m + 3)\n    return ((N % D) * ESCALA) // D - MITJA_ESCALA\n\ndef desfase_espell_scaled(m: int, N: int) -> int:\n    \"\"\"ΔΦ usant l'espell aritmètic en coma fixa.\"\"\"\n    dB = d_scaled(m, N)\n    B = 2 * m + 3\n    A = N // B\n    if A < 3: return 0\n    me = (A - 3) // 2\n    dA = d_scaled(me, N)\n    return dB - dA\n\ndef check_factor(m: int, N: int) -> bool:\n    D = 2 * m + 3\n    return D > 1 and D < N and (N % D == 0)\n\n# ============================================================================\n#  BLOC 2 — K-SWEEP PARAL·LELITZAT (Optimitzat per a Colab)\n# ============================================================================\n\ndef k_sweep_worker(args):\n    N, k_inici, k_fi = args\n    for k in range(k_inici, k_fi + 1):\n        if k <= 0: continue\n        c = N // k\n        if c > 2 and c % 2 != 0:\n            if N % c == 0: return c\n    return None\n\ndef k_sweep_parallel(N, m_ini, m_fi):\n    \"\"\"Executa el k-sweep de Víctor usant tots els nuclis de la CPU.\"\"\"\n    k_lo = max(1, N // (2 * m_fi + 3))\n    k_hi = N // (2 * m_ini + 3)\n    n_total_k = k_hi - k_lo + 1\n    \n    n_cores = cpu_count()\n    pas_k = math.ceil(n_total_k / n_cores)\n    tasques = [(N, k_lo + i*pas_k, min(k_lo + (i+1)*pas_k - 1, k_hi)) for i in range(n_cores)]\n            \n    with Pool(processes=n_cores) as pool:\n        resultats = pool.map(k_sweep_worker, tasques)\n        \n    for r in resultats:\n        if r: return r\n    return None\n\n# ============================================================================\n#  BLOC 3 — BISECCIÓ ΔΦ (Flux de la v20)\n# ============================================================================\n\ndef biseccio_delta_phi_scaled(N, m_ini, m_fi, verbose=True):\n    \"\"\"Bisecció de la v20 utilitzant l'oracle de coma fixa per a alta escala.\"\"\"\n    # log2(m_max) aprox biseccions\n    max_bisec = int(N.bit_length() * 1.66)\n    \n    for it in range(max_bisec):\n        m_c = (m_ini + m_fi) // 2\n        \n        # Comprovem n_k per veure si ja és mosegable\n        k_max = N // (2 * m_ini + 3)\n        k_min = N // (2 * m_fi + 3)\n        if (k_max - k_min) < LIM_KSWEEP_TOTAL:\n            if verbose: print(f\"    [!] Segment acotat a l'iteració {it} (Rang k: {k_max - k_min})\")\n            break\n            \n        # Oracle de fase escalat\n        df_e = desfase_espell_scaled(m_ini, N)\n        df_c = desfase_espell_scaled(m_c, N)\n        \n        if df_e * df_c < 0:\n            m_fi = m_c\n        else:\n            m_ini = m_c\n            \n    return m_ini, m_fi\n\n# ============================================================================\n#  ORQUESTRADOR v21 (Flux exacte de Víctor)\n# ============================================================================\n\ndef mdc_v21(N, verbose=True):\n    bar = \"=\" * 80\n    if verbose:\n        print(f\"\\n{bar}\")\n        print(f\"  MDC v21 — MOTOR DE FASE ESCALADA (Flux v20)\")\n        print(f\"  N = {N}\")\n        print(f\"  Mida: {N.bit_length()} bits | {len(str(N))} dígits\")\n        print(f\"{bar}\\n\")\n\n    t0 = time.perf_counter()\n    m_max = (math.isqrt(N) - 3) // 2\n    \n    # FASE 0: Criba ràpida\n    if verbose: print(f\"[*] FASE 0: Criba roda fins m={LIM_CRIBA}...\")\n    # (Lògica de criba omesa aquí per brevetat, ja la tens a la v20)\n\n    # FASE 1: K-sweep prop de √N (Estratègia de Víctor)\n    # Calculem el segment k prop de m_max segons el teu LIM_KSWEEP\n    k_top = max(1, N // (2 * m_max + 3))\n    k_lim = k_top + LIM_KSWEEP_TOTAL\n    m_lim = (N // k_lim - 3) // 2 if k_lim > 0 else 1\n    \n    if verbose: print(f\"[*] FASE 1: K-sweep √N en {cpu_count()} nuclis...\")\n    factor = k_sweep_parallel(N, max(1, m_lim), m_max)\n    if factor:\n        _èxit(N, factor, t0)\n        return\n\n    # FASE 2: Bisecció ΔΦ (Si no era a l'arrel)\n    if verbose: print(f\"[*] FASE 2: Iniciant bisecció ΔΦ sobre el domini central...\")\n    m_ini_ac, m_fi_ac = biseccio_delta_phi_scaled(N, LIM_CRIBA, m_max, verbose)\n    \n    # K-sweep final del segment detectat per bisecció\n    if verbose: print(f\"[*] FASE 2b: K-sweep final del segment detectat...\")\n    factor = k_sweep_parallel(N, m_ini_ac, m_fi_ac)\n    \n    if factor:\n        _èxit(N, factor, t0)\n    else:\n        print(f\"\\n✗ Factor no trobat. Temps: {time.perf_counter()-t0:.4f}s\")\n\ndef _èxit(N, factor, t0):\n    t_f = time.perf_counter() - t0\n    print(f\"\\n\" + \"█\" * 80)\n    print(f\"  🎯 FACTOR TROBAT: {factor}\")\n    print(f\"  ⏱️  Temps total d'execució: {t_f:.4f} segons\")\n    print(\"█\" * 80)\n\nif __name__ == \"__main__\":\n    # Test amb 101 dígits\n    N_TEST = 10000000000000000000000000000000000000000000000009800000000000000000000000000000000000000000000002301\n    mdc_v21(N_TEST)","outputs":[],"execution_count":null,"metadata":{}}],"metadata":{"colab":{"from_bard":true},"kernelspec":{"display_name":"Python 3","name":"python3"}},"nbformat":4,"nbformat_minor":0}