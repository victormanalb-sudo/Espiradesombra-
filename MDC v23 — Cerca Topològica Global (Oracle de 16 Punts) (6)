{"cells":[{"cell_type":"code","source":"# -*- coding: utf-8 -*-\n\"\"\"\n==============================================================================\n  MDC v23 — ARQUITECTURA DE CERCA GLOBAL (NO-LIMITS)\n  Optimitzat per a Google Colab - Cerca per Ressonància de Fase\n==============================================================================\n  AUTOR : Víctor Manzanares Alberola\n  \n  AVANÇOS v23:\n    - Eliminació de cerques \"shortcuts\" prop de l'arrel.\n    - FASE 1: \"Global Phase Scan\" (16 punts) que cobreix [1, m_max].\n    - FASE 2: Bisecció Topològica dirigida pel canvi de signe del senyal.\n    - Aquesta versió no \"suposa\" on és el factor; el troba per interferència.\n==============================================================================\n\"\"\"\n\nimport math\nimport time\nfrom multiprocessing import Pool, cpu_count\n\n# ============================================================================\n#  CONFIGURACIÓ DE PRECISIÓ MILITAR (v23)\n# ============================================================================\nPRECISIO_P = 3000  \nESCALA = 10 ** PRECISIO_P\nMITJA_ESCALA = ESCALA // 2\n\n# Paràmetres de control\nLIM_KSWEEP_TOTAL = 4_000_000 \n\n# ============================================================================\n#  BLOC 1 — MOTOR DE FASE ESCALADA (Sencers BigInt)\n# ============================================================================\n\ndef d_scaled(m: int, N: int) -> int:\n    \"\"\"Funció d'ona en coma fixa. d(m) = ((N % D) / D) - 0.5\"\"\"\n    D = 2 * (2 * m + 3)\n    return ((N % D) * ESCALA) // D - MITJA_ESCALA\n\ndef desfase_espell_scaled(m: int, N: int) -> int:\n    \"\"\"Calcula el desfase ΔΦ entre la senyal principal i l'espell aritmètic.\"\"\"\n    dB = d_scaled(m, N)\n    B = 2 * m + 3\n    A = N // B\n    if A < 3: return 0\n    me = (A - 3) // 2\n    dA = d_scaled(me, N)\n    return dB - dA\n\n# ============================================================================\n#  BLOC 2 — ESCANEIG I BISECCIÓ UNIVERSAL (L'Oracle Real)\n# ============================================================================\n\ndef biseccio_global_v23(N, m_ini, m_fi, verbose=True):\n    \"\"\"\n    Ja no bisectem a cegues. Primer busquem el canvi de signe \n    en una malla de 16 punts per cobrir tot el rang.\n    \"\"\"\n    num_mostres = 16\n    pas_inicial = (m_fi - m_ini) // num_mostres\n    punts = [m_ini + i * pas_pas_inicial for i in range(num_mostres + 1)]\n    \n    if verbose: print(f\"[*] Fase d'Escaneig Global: Avaluant {num_mostres} punts de control...\")\n    \n    # 1. Busquem el canvi de signe en la malla global\n    segment_trobat = None\n    for i in range(len(punts) - 1):\n        df1 = desfase_espell_scaled(punts[i], N)\n        df2 = desfase_espell_scaled(punts[i+1], N)\n        \n        if df1 * df2 < 0:\n            segment_trobat = (punts[i], punts[i+1])\n            if verbose: print(f\"    [!] Ressonància detectada al segment {i} -> [{punts[i]:.2e}, {punts[i+1]:.2e}]\")\n            break\n            \n    # 2. Si no hi ha canvi de signe (aliasing), triem el punt de mínim valor absolut\n    if not segment_trobat:\n        if verbose: print(\"    [?] No s'ha detectat canvi de signe directe. Buscant mínim d'energia...\")\n        valors = [abs(desfase_espell_scaled(p, N)) for p in punts]\n        idx_min = valors.index(min(valors))\n        i_start = max(0, idx_min - 1)\n        i_end = min(len(punts)-1, idx_min + 1)\n        segment_trobat = (punts[i_start], punts[i_end])\n\n    # 3. Bisecció profunda sobre el segment detectat\n    m_a, m_b = segment_trobat\n    num_biseccions = int(N.bit_length() * 1.66)\n    \n    for it in range(num_biseccions):\n        m_c = (m_a + m_b) // 2\n        df_a = desfase_espell_scaled(m_a, N)\n        df_c = desfase_espell_scaled(m_c, N)\n        \n        if df_a * df_c < 0:\n            m_b = m_c\n        else:\n            m_a = m_c\n            \n        # Comprovem si el segment és mosegable\n        k_max = N // (2 * m_a + 3)\n        k_min = N // (2 * m_b + 3)\n        if (k_max - k_min) < LIM_KSWEEP_TOTAL:\n            if verbose: print(f\"    [!] Bisecció tancada a l'iteració {it} (Rang k: {k_max - k_min})\")\n            break\n            \n    return m_a, m_b\n\n# ============================================================================\n#  BLOC 3 — K-SWEEP PARAL·LELITZAT\n# ============================================================================\n\ndef k_sweep_worker(args):\n    N, k_inici, k_fi = args\n    for k in range(k_inici, k_fi + 1):\n        if k <= 0: continue\n        c = N // k \n        if c > 2 and c % 2 != 0:\n            if N % c == 0: return c\n    return None\n\ndef k_sweep_parallel(N, k_min, k_max):\n    k_min, k_max = int(k_min), int(k_max)\n    n_total_k = k_max - k_min + 1\n    if n_total_k <= 0: return None\n    \n    n_cores = cpu_count()\n    pas_k = math.ceil(n_total_k / n_cores)\n    tasques = [(N, k_min + i*pas_k, min(k_min + (i+1)*pas_k - 1, k_max)) for i in range(n_cores)]\n            \n    with Pool(processes=n_cores) as pool:\n        resultats = pool.map(k_sweep_worker, tasques)\n        \n    for r in resultats:\n        if r: return r\n    return None\n\n# ============================================================================\n#  ORQUESTRADOR v23 (Cerca per Senyal Pura)\n# ============================================================================\n\ndef mdc_v23(N, verbose=True):\n    bar = \"=\" * 80\n    if verbose:\n        print(f\"\\n{bar}\")\n        print(f\"  MDC v23 — UNITAT DE CERCA TOPOLÒGICA GLOBAL\")\n        print(f\"  N = {N}\")\n        print(f\"  Mida: {N.bit_length()} bits | {len(str(N))} dígits\")\n        print(f\"{bar}\\n\")\n\n    t0 = time.perf_counter()\n    m_max = (math.isqrt(N) - 3) // 2\n    \n    # FASE 1: Bisecció dirigida per Senyal (tot el rang)\n    if verbose: print(f\"[*] Iniciant Cerca Topològica Global [1, m_max]...\")\n    m_ini_ac, m_fi_ac = biseccio_global_v23(N, 1, m_max, verbose)\n    \n    # FASE 2: Escombrat final\n    k_min = N // (2 * m_fi_ac + 3)\n    k_max = N // (2 * m_ini_ac + 3)\n    \n    if verbose: print(f\"[*] Escaneig final de precisió [k_min:{k_min}, k_max:{k_max}]...\")\n    factor = k_sweep_parallel(N, k_min - 200, k_max + 200)\n    \n    t1 = time.perf_counter()\n    if factor:\n        print(f\"\\n\" + \"█\" * 80)\n        print(f\"  🎯 FACTOR TROBAT!\")\n        print(f\"  P: {factor}\")\n        print(f\"  Q: {N // factor}\")\n        print(f\"  ⏱️  Temps total d'execució: {t1 - t0:.4f} segons\")\n        print(\"█\" * 80)\n    else:\n        print(f\"\\n✗ Factor no trobat. Temps total: {t1 - t0:.4f} segons\")\n\nif __name__ == \"__main__\":\n    # N de 101 dígits equilibrat\n    N_TEST = 10000000000000000000000000000000000000000000000009800000000000000000000000000000000000000000000002301\n    mdc_v23(N_TEST)","outputs":[],"execution_count":null,"metadata":{}}],"metadata":{"colab":{"from_bard":true},"kernelspec":{"display_name":"Python 3","name":"python3"}},"nbformat":4,"nbformat_minor":0}