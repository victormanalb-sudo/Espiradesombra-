{"cells":[{"cell_type":"code","source":["# -*- coding: utf-8 -*-\n","\"\"\"\n","==============================================================================\n","  MDC v21.1 — ARQUITECTURA MILITAR (RSA-4096 / 8192 READY)\n","  Optimitzat per a Google Colab - Versió Estabilitzada\n","==============================================================================\n","  AUTOR : Víctor Manzanares Alberola\n","\n","  MILLORA v21.1:\n","    - S'ha afegit la FASE 1: Escombrat de Resonància a l'Arrel.\n","    - Ideal per a factors equilibrats (RSA) on la bisecció és més inestable.\n","    - Manté la bisecció Delta-Phi per a factors asimètrics.\n","==============================================================================\n","\"\"\"\n","\n","import math\n","import time\n","from multiprocessing import Pool, cpu_count\n","\n","# ============================================================================\n","#  CONFIGURACIÓ DE PRECISIÓ\n","# ============================================================================\n","PRECISIO_P = 1500  # Resolució de la \"lupa\" per a 4096 bits\n","ESCALA = 10 ** PRECISIO_P\n","MITJA_ESCALA = ESCALA // 2\n","\n","# Paràmetres de control\n","LIM_KSWEEP_TOTAL = 3_000_000 # Capacitat total d'escombrat ràpid\n","\n","# ============================================================================\n","#  BLOC 1 — MOTOR D'ARITMÈTICA ESCALADA\n","# ============================================================================\n","\n","def d_scaled(m: int, N: int) -> int:\n","    \"\"\"Funció d'ona en coma fixa (evita la fricció de Fraction).\"\"\"\n","    D = 2 * (2 * m + 3)\n","    return ((N % D) * ESCALA) // D - MITJA_ESCALA\n","\n","def desfase_espell_scaled(m: int, N: int) -> int:\n","    \"\"\"Calcula ΔΦ usant l'espell aritmètic.\"\"\"\n","    dB = d_scaled(m, N)\n","    B = 2 * m + 3\n","    A = N // B\n","    if A < 3: return 0\n","    me = (A - 3) // 2\n","    dA = d_scaled(me, N)\n","    return dB - dA\n","\n","# ============================================================================\n","#  BLOC 2 — K-SWEEP PARAL·LELITZAT\n","# ============================================================================\n","\n","def k_sweep_worker(args):\n","    \"\"\"Cerca de factors en un sub-segment de pendents k.\"\"\"\n","    N, k_inici, k_fi = args\n","    for k in range(k_inici, k_fi + 1):\n","        if k <= 0: continue\n","        c = N // k\n","        if c > 2 and c % 2 != 0:\n","            if N % c == 0:\n","                return c\n","    return None\n","\n","def k_sweep_parallel(N, k_min, k_max):\n","    \"\"\"Distribueix l'escombrat entre els nuclis de la CPU.\"\"\"\n","    n_total_k = k_max - k_min + 1\n","    n_cores = cpu_count()\n","    pas_k = math.ceil(n_total_k / n_cores)\n","\n","    tasques = []\n","    for i in range(n_cores):\n","        k_s = k_min + i * pas_k\n","        k_e = min(k_s + pas_k - 1, k_max)\n","        if k_s <= k_e:\n","            tasques.append((N, k_s, k_e))\n","\n","    with Pool(processes=n_cores) as pool:\n","        resultats = pool.map(k_sweep_worker, tasques)\n","\n","    for r in resultats:\n","        if r: return r\n","    return None\n","\n","# ============================================================================\n","#  BLOC 3 — ORACLE DE BISECCIÓ ΔΦ\n","# ============================================================================\n","\n","def biseccio_militar(N, m_ini, m_fi, verbose=True):\n","    \"\"\"Reducció logarítmica del domini de cerca.\"\"\"\n","    num_biseccions = int(N.bit_length() * 1.66)\n","\n","    for it in range(num_biseccions):\n","        m_c = (m_ini + m_fi) // 2\n","        df_e = desfase_espell_scaled(m_ini, N)\n","        df_c = desfase_espell_scaled(m_c, N)\n","\n","        if df_e * df_c < 0:\n","            m_fi = m_c\n","        else:\n","            m_ini = m_c\n","\n","        pos_i, pos_f = 2 * m_ini + 3, 2 * m_fi + 3\n","        if (N // pos_i - N // pos_f) < LIM_KSWEEP_TOTAL:\n","            if verbose: print(f\"    [!] Bisecció completada a l'iteració {it}\")\n","            break\n","\n","    return m_ini, m_fi\n","\n","# ============================================================================\n","#  ORQUESTRADOR v21.1\n","# ============================================================================\n","\n","def mdc_v21(N, verbose=True):\n","    bar = \"=\" * 80\n","    if verbose:\n","        print(f\"\\n{bar}\")\n","        print(f\"  MDC v21.1 — UNITAT D'EXECUCIÓ MILITAR (√N RESONANCE)\")\n","        print(f\"  N = {N}\")\n","        print(f\"  Mida: {N.bit_length()} bits | {len(str(N))} dígits\")\n","        print(f\"{bar}\\n\")\n","\n","    t0 = time.perf_counter()\n","    root_n = math.isqrt(N)\n","    m_max = (root_n - 3) // 2\n","\n","    # FASE 1: RESONÀNCIA DE L'ARREL (Estratègic per a RSA / Factors equilibrats)\n","    if verbose: print(f\"[*] FASE 1: Escombrat de resonància prop de √N...\")\n","    # Busquem factors on la pendent k és propera a l'arrel\n","    k_arrel = root_n\n","    factor = k_sweep_parallel(N, k_arrel - (LIM_KSWEEP_TOTAL // 2), k_arrel + (LIM_KSWEEP_TOTAL // 2))\n","\n","    if factor:\n","        t1 = time.perf_counter()\n","        _presentar_èxit(N, factor, t0, t1)\n","        return\n","\n","    # FASE 2: BISECCIÓ TOPOLÒGICA (Per a factors asimètrics)\n","    if verbose: print(f\"[*] FASE 2: No trobat a l'arrel. Iniciant bisecció ΔΦ...\")\n","    m_ini_ac, m_fi_ac = biseccio_militar(N, 1, m_max, verbose)\n","\n","    # FASE 3: ESCOMBRAT FINAL DEL SEGMENT ACOTAT\n","    if verbose: print(f\"[*] FASE 3: Escombrat final del segment acotat...\")\n","    k_min = N // (2 * m_fi_ac + 3)\n","    k_max = N // (2 * m_ini_ac + 3)\n","    factor = k_sweep_parallel(N, k_min, k_max)\n","\n","    t1 = time.perf_counter()\n","\n","    if factor:\n","        _presentar_èxit(N, factor, t0, t1)\n","    else:\n","        print(f\"\\n✗ Factor no trobat. Temps total: {t1 - t0:.4f} segons\")\n","\n","def _presentar_èxit(N, factor, t0, t1):\n","    print(f\"\\n\" + \"█\" * 80)\n","    print(f\"  🎯 FACTOR TROBAT: {factor}\")\n","    print(f\"  🔑 Factor q: {N // factor}\")\n","    print(f\"  ⏱️  Temps total d'execució: {t1 - t0:.4f} segons\")\n","    print(\"█\" * 80)\n","\n","# ============================================================================\n","#  EXECUCIÓ\n","# ============================================================================\n","if __name__ == \"__main__\":\n","    # EL TEU N DE 101 DÍGITS\n","    N_TEST = 100000000000000000000000000000000000000000000000098000000000000000000000000000000000000000000000023011\n","    mdc_v21(N_TEST)"],"outputs":[{"output_type":"stream","name":"stdout","text":["\n","================================================================================\n","  MDC v21.1 — UNITAT D'EXECUCIÓ MILITAR (√N RESONANCE)\n","  N = 100000000000000000000000000000000000000000000000098000000000000000000000000000000000000000000000023011\n","  Mida: 336 bits | 102 dígits\n","================================================================================\n","\n","[*] FASE 1: Escombrat de resonància prop de √N...\n","[*] FASE 2: No trobat a l'arrel. Iniciant bisecció ΔΦ...\n","    [!] Bisecció completada a l'iteració 146\n","[*] FASE 3: Escombrat final del segment acotat...\n","\n","✗ Factor no trobat. Temps total: 2.6111 segons\n"]}],"execution_count":2,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"2pWKOBWqgjSu","executionInfo":{"status":"ok","timestamp":1775776284325,"user_tz":-120,"elapsed":2670,"user":{"displayName":"VICTOR manzanares alberola","userId":"12610567503648056488"}},"outputId":"b49af178-8fb8-4371-c158-37b8b474e638"}}],"metadata":{"colab":{"provenance":[]},"kernelspec":{"display_name":"Python 3","name":"python3"}},"nbformat":4,"nbformat_minor":0}