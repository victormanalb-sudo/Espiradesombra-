import math

# Criterio MRAUV de holgura creciente
# M(n)=(Delta-gap)/Delta

FAC=[1.0]
for i in range(1,400):
    FAC.append(FAC[-1]/i)


def L(n):
    return int(math.sqrt(n+3))+7


def K(n):
    return max(2,int(int(math.sqrt(n))*9/24))


def m(n):
    r=math.sqrt(n+3)
    k=min(K(n),399)
    return sum(r*FAC[i] for i in range(2,k+1))


def delta(n):
    return L(n)-m(n)


def sieve(limit):
    p=[True]*(limit+1)
    p[0]=p[1]=False
    for i in range(2,int(limit**0.5)+1):
        if p[i]:
            for j in range(i*i,limit+1,i):
                p[j]=False
    return [i for i,v in enumerate(p) if v]


def experimento(limit=100000):
    primes=sieve(limit)

    mejor=float('inf')

    for a,b in zip(primes,primes[1:]):
        gap=b-a
        d=delta(a)
        margen=d-gap
        M=margen/d if d else 0

        mejor=min(mejor,M)

        print(f'{a},{gap},{d:.4f},{margen:.4f},{M:.6f}')

    print('
PEOR MARGEN=',mejor)

if __name__=='__main__':
    experimento()
