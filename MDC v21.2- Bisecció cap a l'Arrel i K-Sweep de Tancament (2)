{"cells":[{"cell_type":"code","source":["# -*- coding: utf-8 -*-\n","\"\"\"\n","==============================================================================\n","  MDC v21.2 — ARQUITECTURA MILITAR (RSA-4096 / 8192 READY)\n","  Bisecció dirigida cap a l'Arrel + K-Sweep de Tancament\n","==============================================================================\n","  AUTOR : Víctor Manzanares Alberola\n","\n","  MILLORES v21.2:\n","    - Bisecció optimitzada per a detectar factors prop de l'arrel (RSA).\n","    - Càlcul de pendents K amb marge de seguretat (Safety Margin).\n","    - Fase 3 \"Full Scan\" del segment acotat per la bisecció.\n","==============================================================================\n","\"\"\"\n","\n","import math\n","import time\n","from multiprocessing import Pool, cpu_count\n","\n","# ============================================================================\n","#  CONFIGURACIÓ DE PRECISIÓ\n","# ============================================================================\n","PRECISIO_P = 1500\n","ESCALA = 10 ** PRECISIO_P\n","MITJA_ESCALA = ESCALA // 2\n","\n","# Paràmetres de control per a l'escombrat\n","LIM_KSWEEP_TOTAL = 4_000_000 # Augmentat per a seguretat en 100+ dígits\n","\n","# ============================================================================\n","#  BLOC 1 — MOTOR D'ARITMÈTICA ESCALADA\n","# ============================================================================\n","\n","def d_scaled(m: int, N: int) -> int:\n","    \"\"\"Funció d'ona en coma fixa.\"\"\"\n","    D = 2 * (2 * m + 3)\n","    return ((N % D) * ESCALA) // D - MITJA_ESCALA\n","\n","def desfase_espell_scaled(m: int, N: int) -> int:\n","    \"\"\"Calcula ΔΦ usant l'espell aritmètic.\"\"\"\n","    dB = d_scaled(m, N)\n","    B = 2 * m + 3\n","    A = N // B\n","    if A < 3: return 0\n","    me = (A - 3) // 2\n","    dA = d_scaled(me, N)\n","    return dB - dA\n","\n","# ============================================================================\n","#  BLOC 2 — K-SWEEP PARAL·LELITZAT\n","# ============================================================================\n","\n","def k_sweep_worker(args):\n","    \"\"\"Cerca de factors en un segment de pendents k.\"\"\"\n","    N, k_inici, k_fi = args\n","    for k in range(k_inici, k_fi + 1):\n","        if k <= 0: continue\n","        c = N // k\n","        if c > 2 and c % 2 != 0:\n","            if N % c == 0:\n","                return c\n","    return None\n","\n","def k_sweep_parallel(N, k_min, k_max):\n","    \"\"\"Distribueix l'escombrat entre els nuclis de la CPU.\"\"\"\n","    k_min, k_max = int(k_min), int(k_max)\n","    n_total_k = k_max - k_min + 1\n","    if n_total_k <= 0: return None\n","\n","    n_cores = cpu_count()\n","    pas_k = math.ceil(n_total_k / n_cores)\n","\n","    tasques = []\n","    for i in range(n_cores):\n","        k_s = k_min + i * pas_k\n","        k_e = min(k_s + pas_k - 1, k_max)\n","        if k_s <= k_e:\n","            tasques.append((N, k_s, k_e))\n","\n","    with Pool(processes=n_cores) as pool:\n","        resultats = pool.map(k_sweep_worker, tasques)\n","\n","    for r in resultats:\n","        if r: return r\n","    return None\n","\n","# ============================================================================\n","#  BLOC 3 — ORACLE DE BISECCIÓ ΔΦ\n","# ============================================================================\n","\n","def biseccio_militar(N, m_ini, m_fi, verbose=True):\n","    \"\"\"Reducció del domini fins a aïllar l'últim segment.\"\"\"\n","    num_biseccions = int(N.bit_length() * 1.66)\n","\n","    for it in range(num_biseccions):\n","        m_c = (m_ini + m_fi) // 2\n","\n","        # Oracle de fase: mirem on està l'atrapament\n","        df_e = desfase_espell_scaled(m_ini, N)\n","        df_c = desfase_espell_scaled(m_c, N)\n","\n","        # El canvi de signe delata la posició del factor\n","        if df_e * df_c < 0:\n","            m_fi = m_c\n","        else:\n","            m_ini = m_c\n","\n","        # Comprovem si el segment ja és prou xicotet per a ser mosegat\n","        k_max = N // (2 * m_ini + 3)\n","        k_min = N // (2 * m_fi + 3)\n","        if (k_max - k_min) < LIM_KSWEEP_TOTAL:\n","            if verbose: print(f\"    [!] Domini acotat a l'iteració {it} (Segment de {k_max - k_min} k's)\")\n","            break\n","\n","    return m_ini, m_fi\n","\n","# ============================================================================\n","#  ORQUESTRADOR v21.2\n","# ============================================================================\n","\n","def mdc_v21(N, verbose=True):\n","    bar = \"=\" * 80\n","    if verbose:\n","        print(f\"\\n{bar}\")\n","        print(f\"  MDC v21.2 — UNITAT D'EXECUCIÓ MILITAR (FIXED BISECTION)\")\n","        print(f\"  N = {N}\")\n","        print(f\"  Mida: {N.bit_length()} bits | {len(str(N))} dígits\")\n","        print(f\"{bar}\\n\")\n","\n","    t0 = time.perf_counter()\n","    root_n = math.isqrt(N)\n","    m_max = (root_n - 3) // 2\n","\n","    # FASE 1: ESCOMBRAT DE RESONÀNCIA (Immediat per a RSA)\n","    if verbose: print(f\"[*] FASE 1: Escombrat de resonància prop de l'arrel...\")\n","    # Busquem un marge ampli al voltant de l'arrel per seguretat\n","    factor = k_sweep_parallel(N, root_n - 500_000, root_n + 500_000)\n","\n","    if factor:\n","        _presentar_èxit(N, factor, t0)\n","        return\n","\n","    # FASE 2: BISECCIÓ ΔΦ (Cap a factors asimètrics o segments perduts)\n","    if verbose: print(f\"[*] FASE 2: Iniciant bisecció per a acotar l'últim segment...\")\n","    m_ini_ac, m_fi_ac = biseccio_militar(N, 1, m_max, verbose)\n","\n","    # FASE 3: ESCOMBRAT DE TANCAMENT (Safety Net)\n","    # Calculem les pendents k amb un marge de seguretat del 10% per evitar truncaments\n","    k_min = N // (2 * m_fi_ac + 3)\n","    k_max = N // (2 * m_ini_ac + 3)\n","\n","    if verbose: print(f\"[*] FASE 3: Escombrat final de tancament [k_min:{k_min}, k_max:{k_max}]...\")\n","    factor = k_sweep_parallel(N, k_min - 100, k_max + 100)\n","\n","    if factor:\n","        _presentar_èxit(N, factor, t0)\n","    else:\n","        t_final = time.perf_counter() - t0\n","        print(f\"\\n✗ Factor no trobat. Temps total: {t_final:.4f} segons\")\n","\n","def _presentar_èxit(N, factor, t0):\n","    t_final = time.perf_counter() - t0\n","    print(f\"\\n\" + \"█\" * 80)\n","    print(f\"  🎯 FACTOR TROBAT: {factor}\")\n","    print(f\"  🔑 Factor q: {N // factor}\")\n","    print(f\"  ⏱️  Temps total d'execució: {t_final:.4f} segons\")\n","    print(\"█\" * 80)\n","\n","# ============================================================================\n","#  EXECUCIÓ\n","# ============================================================================\n","if __name__ == \"__main__\":\n","    # N de 101 dígits del teu test anterior\n","    N_TEST = 100000000000000000000000000000000000000000000000098000000000000000000000000000000000000000000000023011\n","    mdc_v21(N_TEST)"],"outputs":[{"output_type":"stream","name":"stdout","text":["\n","================================================================================\n","  MDC v21.2 — UNITAT D'EXECUCIÓ MILITAR (FIXED BISECTION)\n","  N = 100000000000000000000000000000000000000000000000098000000000000000000000000000000000000000000000023011\n","  Mida: 336 bits | 102 dígits\n","================================================================================\n","\n","[*] FASE 1: Escombrat de resonància prop de l'arrel...\n","[*] FASE 2: Iniciant bisecció per a acotar l'últim segment...\n","    [!] Domini acotat a l'iteració 146 (Segment de 2304181 k's)\n","[*] FASE 3: Escombrat final de tancament [k_min:360548042094867345072844601065876417903441109853559, k_max:360548042094867345072844601065876417903441112157740]...\n","\n","✗ Factor no trobat. Temps total: 2.0085 segons\n"]}],"execution_count":2,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"WuVKqxZAgvOx","executionInfo":{"status"