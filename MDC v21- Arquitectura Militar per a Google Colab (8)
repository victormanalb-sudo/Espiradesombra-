{"cells":[{"cell_type":"code","source":"# -*- coding: utf-8 -*-\n\"\"\"\n==============================================================================\n  MDC v21 — ARQUITECTURA MILITAR (RSA-4096 / 8192 READY)\n  Optimitzat per a Google Colab\n==============================================================================\n  AUTOR : Víctor Manzanares Alberola\n  CONCEPTES CLAU:\n    1. Aritmètica de Coma Fixa (Escalat BigInt) per a evitar la fricció de Fraction.\n    2. Oracle de Bisecció Delta-Phi (ΔΦ) per a reducció logarítmica del domini.\n    3. K-Sweep Paral·lelitzat per a l'escombrat final de precisió.\n==============================================================================\n\"\"\"\n\nimport math\nimport time\nfrom multiprocessing import Pool, cpu_count\n\n# ============================================================================\n#  CONFIGURACIÓ DE PRECISIÓ (Ajustat per a milers de dígits)\n# ============================================================================\n# Escalem per 10^P per simular decimals amb sencers BigInt.\n# Per a RSA-4096 (1233 dígits), P=1500 és ideal per a mantenir la fase neta.\nPRECISIO_P = 1500  \nESCALA = 10 ** PRECISIO_P\nMITJA_ESCALA = ESCALA // 2\n\n# Paràmetres de control del domini\nLIM_CRIBA = 2_000_000\nLIM_KSWEEP_PER_NUCLEI = 1_500_000  # Quantitat de k que revisa cada fil de CPU\n\n# ============================================================================\n#  BLOC 1 — MOTOR D'ARITMÈTICA ESCALADA (Sencers de Precisió Arbitrària)\n# ============================================================================\n\ndef d_scaled(m: int, N: int) -> int:\n    \"\"\"\n    Funció d'ona en coma fixa.\n    Matemàtica: d(m) = ((N % D) / D) - 0.5\n    Implementació escalada: ((N % D) * ESCALA) // D - (ESCALA // 2)\n    \"\"\"\n    D = 2 * (2 * m + 3)\n    # Multiplicació escalada abans de la divisió sencera per a preservar decimals\n    return ((N % D) * ESCALA) // D - MITJA_ESCALA\n\ndef desfase_espell_scaled(m: int, N: int) -> int:\n    \"\"\"\n    Calcula el desfase ΔΦ usant l'espell aritmètic en coma fixa.\n    Propietat: ΔΦ(m) = d_principal(m) - d_espell(m_cofactor)\n    \"\"\"\n    dB = d_scaled(m, N)\n    \n    # Càlcul de l'espell aritmètic (cofactor complementari)\n    B = 2 * m + 3\n    A = N // B\n    if A < 3: return 0\n    me = (A - 3) // 2\n    \n    dA = d_scaled(me, N)\n    return dB - dA\n\n# ============================================================================\n#  BLOC 2 — K-SWEEP PARAL·LELITZAT (Escombrat de Multiprocessament)\n# ============================================================================\n\ndef k_sweep_worker(args):\n    \"\"\"Funció de treball per a cada nucli de CPU: busca factors en un rang de k.\"\"\"\n    N, k_inici, k_fi = args\n    for k in range(k_inici, k_fi + 1):\n        if k <= 0: continue\n        c = N // k  # Zero de la recta k\n        if c > 2 and c % 2 != 0:\n            if N % c == 0:\n                return c\n    return None\n\ndef k_sweep_parallel(N, m_ini, m_fi):\n    \"\"\"Divideix l'escombrat de pendents k entre tots els nuclis de Colab.\"\"\"\n    k_lo = max(1, N // (2 * m_fi + 3))\n    k_hi = N // (2 * m_ini + 3)\n    n_total_k = k_hi - k_lo + 1\n    \n    n_cores = cpu_count()\n    pas_k = math.ceil(n_total_k / n_cores)\n    \n    tasques = []\n    for i in range(n_cores):\n        k_s = k_lo + i * pas_k\n        k_e = min(k_s + pas_k - 1, k_hi)\n        if k_s <= k_e:\n            tasques.append((N, k_s, k_e))\n            \n    # Execució en paral·lel\n    with Pool(processes=n_cores) as pool:\n        resultats = pool.map(k_sweep_worker, tasques)\n        \n    for r in resultats:\n        if r: return r\n    return None\n\n# ============================================================================\n#  BLOC 3 — ORACLE DE BISECCIÓ ΔΦ (Complexitat O(log N))\n# ============================================================================\n\ndef biseccio_militar(N, m_ini, m_fi, verbose=True):\n    \"\"\"\n    Redueix el domini de cerca a la meitat en cada pas mitjançant\n    el canvi de signe de l'oracle de fase ΔΦ.\n    \"\"\"\n    # Nombre de biseccions logarítmicament proporcional a la mida del número\n    # (D x 1.66 aproximadament)\n    num_biseccions = int(N.bit_length() * 1.66) \n    \n    if verbose: print(f\"    [!] Iniciant bisecció topològica...\")\n\n    for it in range(num_biseccions):\n        m_c = (m_ini + m_fi) // 2\n        \n        # Comprovació de l'atrapament del factor (canvi de signe)\n        df_e = desfase_espell_scaled(m_ini, N)\n        df_c = desfase_espell_scaled(m_c, N)\n        \n        if df_e * df_c < 0:\n            m_fi = m_c\n        else:\n            m_ini = m_c\n            \n        if verbose and it % 100 == 0:\n            distancia = m_fi - m_ini\n            print(f\"    ... bisecció {it:4d} | Domini restant: {distancia:.2e} m\")\n            \n        # Aturada prematura si el segment ja és manejable per al K-sweep paral·lel\n        pos_i, pos_f = 2 * m_ini + 3, 2 * m_fi + 3\n        if (N // pos_i - N // pos_f) < (LIM_KSWEEP_PER_NUCLEI * cpu_count()):\n            if verbose: print(f\"    [!] Domini acotat correctament en la iteració {it}\")\n            break\n            \n    return m_ini, m_fi\n\n# ============================================================================\n#  ORQUESTRADOR v21\n# ============================================================================\n\ndef mdc_v21(N, verbose=True):\n    \"\"\"Orquestrador principal del Mètode Diofàntic Cinemàtic v21.\"\"\"\n    bar = \"=\" * 80\n    if verbose:\n        print(f\"\\n{bar}\")\n        print(f\"  MDC v21 — UNITAT D'EXECUCIÓ MILITAR\")\n        print(f\"  N = {N}\")\n        print(f\"  Mida: {N.bit_length()} bits | {len(str(N))} dígits\")\n        print(f\"{bar}\\n\")\n\n    t0 = time.perf_counter()\n    m_max = (math.isqrt(N) - 3) // 2\n    \n    # FASE 1: Bisecció Topològica (Oracle de Fase)\n    if verbose: print(f\"[*] FASE 1: Bisecció binària ΔΦ...\")\n    m_ini_acotat, m_fi_acotat = biseccio_militar(N, 1, m_max, verbose)\n    \n    # FASE 2: K-Sweep Paral·lel (Mosegat final)\n    if verbose: print(f\"\\n[*] FASE 2: K-Sweep paral·lel en {cpu_count()} nuclis...\")\n    factor = k_sweep_parallel(N, m_ini_acotat, m_fi_acotat)\n    \n    t1 = time.perf_counter()\n    \n    if factor:\n        print(f\"\\n\" + \"█\" * 80)\n        print(f\"  🎯 FACTOR TROBAT: {factor}\")\n        print(f\"  🔑 Factor q: {N // factor}\")\n        print(f\"  ⏱️  Temps total d'execució: {t1 - t0:.4f} segons\")\n        print(\"█\" * 80)\n    else:\n        print(f\"\\n✗ Factor no trobat. Temps: {t1 - t0:.4f} segons\")\n\n# ============================================================================\n#  PUNT D'ENTRADA PER A COLAB\n# ============================================================================\nif __name__ == \"__main__\":\n    # CAS DE TEST: Número de 50 dígits (aproximadament 166 bits)\n    # Generat a partir de dos primers equilibrats per a simular RSA.\n    p = 100000000000000000000000000000000000000000000000039 # 50 dígits\n    q = 100000000000000000000000000000000000000000000000059 # 50 dígits\n    N_PROVA = p * q\n    \n    mdc_v21(N_PROVA)","outputs":[],"execution_count":null,"metadata":{}}],"metadata":{"colab":{"from_bard":true},"kernelspec":{"display_name":"Python 3","name":"python3"}},"nbformat":4,"nbformat_minor":0}