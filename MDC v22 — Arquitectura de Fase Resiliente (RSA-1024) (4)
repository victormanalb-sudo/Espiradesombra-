{"cells":[{"cell_type":"code","source":"# -*- coding: utf-8 -*-\n\"\"\"\n==============================================================================\n  MDC v22 — MÈTODE DIOFÀNTIC CINEMÀTIC\n  Bisecció amb Vot de Fase · Margen de Seguretat · Escala Militar\n==============================================================================\n  AUTOR : Víctor Manzanares Alberola\n          EPSA / Universitat Politècnica de València (Alcoi)\n\n  ─────────────────────────────────────────────────────────────────────────\n  MILLORES CRÍTIQUES DE LA v22:\n  ─────────────────────────────────────────────────────────────────────────\n  1. VOT DE FASE (Malla de 5 punts): En lloc d'un sol punt central, s'avalua \n     una petita malla per confirmar el signe real i evitar \"falsos zeros\".\n  2. SOLAPAMENT DE SEGURETAT: Quan es tanca el rang, s'afegeix un marge de \n     1.000 unitats per evitar que un salt de fase ens deixe fora el factor.\n  3. MOTOR BIGINT: Manté l'eficiència deKaratsuba per a productes de 300+ dígits.\n  ─────────────────────────────────────────────────────────────────────────\n\"\"\"\n\nimport math\nimport time\n\n# ============================================================================\n#  PARÀMETRES GLOBALS\n# ============================================================================\nPRIMOS    = [2, 3, 5, 7, 11, 13, 17, 19, 23] # Pots ampliar si cal\nPRIMORIAL = math.prod(PRIMOS)\nE_CONV    = (math.e - 1) / 2    # ≈ 0.8591\n\nLIM_CRIBA  = 2_000_000          # Criba ràpida\nLIM_KSWEEP = 2_000_000          # Radi de mosegada final\nMAX_BISEC  = 100000             # Marge per a biseccions en 4096 bits\n\n# ============================================================================\n#  BLOC 1 — RODA I UTILITATS\n# ============================================================================\n\ndef pasa_rueda(m: int) -> bool:\n    if m < 1: return False\n    return math.gcd(2 * m + 3, PRIMORIAL) == 1\n\ndef proper_valid(m: int, pas: int = 1) -> int | None:\n    for _ in range(1000): # Més marge de cerca per a m grans\n        if m < 1: return None\n        if pasa_rueda(m): return m\n        m += pas\n    return None\n\n# ============================================================================\n#  BLOC 2 — MOTOR DE SIGNE I MAGNITUD (BigInt Karatsuba)\n# ============================================================================\n\ndef get_phase_info(m: int, N: int):\n    \"\"\"Retorna signe i magnitud del desfase ΔΦ.\"\"\"\n    D_B = 2 * (2 * m + 3)\n    R_B = N % D_B\n    B = 2 * m + 3\n    if B <= 1 or B >= N: return 0, 10**2000\n    A = N // B\n    if A < 3: return 0, 10**2000\n    m_e = (A - 3) // 2\n    if m_e < 1: return 0, 10**2000\n    D_A = 2 * (2 * m_e + 3)\n    R_A = N % D_A\n\n    # Delta = R_B*D_A - R_A*D_B\n    val = R_B * D_A - R_A * D_B\n    sign = 1 if val > 0 else (-1 if val < 0 else 0)\n    return sign, abs(val)\n\ndef check_factor(m: int, N: int) -> bool:\n    D = 2 * m + 3\n    return D > 1 and D < N and (N % D == 0)\n\n# ============================================================================\n#  BLOC 3 — K-SWEEP EXHAUSTIU\n# ============================================================================\n\ndef k_sweep(N: int, m_ini: int, m_fi: int) -> int | None:\n    k_lo = max(1, N // (2 * m_fi + 3))\n    k_hi = N // (2 * m_ini + 3)\n    for k in range(k_lo, k_hi + 1):\n        if k <= 0: continue\n        c = N // k\n        if c < 3 or c % 2 == 0: continue\n        if N % c == 0 and 1 < c < N: return c\n    return None\n\n# ============================================================================\n#  BLOC 4 — BISECCIÓ v22 (Resilient al Soroll)\n# ============================================================================\n\ndef biseccio_v22(N: int, m_ini: int, m_fi: int, verbose: bool = True) -> int | None:\n    for it in range(MAX_BISEC):\n        pos_i, pos_f = 2 * m_ini + 3, 2 * m_fi + 3\n        k_hi, k_lo = N // pos_i, N // pos_f\n        n_k = k_hi - k_lo + 1\n\n        if n_k <= LIM_KSWEEP:\n            return k_sweep(N, m_ini, m_fi)\n\n        m_c = (m_ini + m_fi) // 2\n        \n        # VOT DE FASE: Analitzem una malla al voltant del centre\n        # Això evita que un sol punt atípic ens enganye\n        offsets = [-20, -10, 0, 10, 20]\n        vots = []\n        for off in offsets:\n            mv = proper_valid(m_c + off, 1)\n            if mv:\n                s, _ = get_phase_info(mv, N)\n                vots.append(s)\n        \n        # Signe democràtic (el més freqüent)\n        if not vots: return None\n        s_c = max(set(vots), key=vots.count)\n        \n        s_e, _ = get_phase_info(proper_valid(m_ini, 1), N)\n\n        # Decisió amb solapament de seguretat\n        if s_e != 0 and s_c != 0 and s_e != s_c:\n            m_fi = m_c + 2000 # Marge de seguretat militar\n        else:\n            m_ini = m_c - 2000\n\n        if verbose and it % 200 == 0:\n            print(f\"    ... bisecció {it:5d} | n_k: {n_k:.2e} | Δm: {m_fi-m_ini:.1e}\")\n\n    return None\n\n# ============================================================================\n#  BLOC 5 — ORQUESTRADOR MDC v22\n# ============================================================================\n\ndef mdc_v22(N: int, verbose: bool = True) -> tuple:\n    t0 = time.perf_counter()\n    m_max = (math.isqrt(N) - 3) // 2\n    \n    # F0: Criba Ràpida\n    for p in PRIMOS:\n        if N % p == 0 and p < N: return p, (time.perf_counter()-t0)*1000\n    \n    # F1: K-sweep prop de √N (Fermat-like)\n    # [Omesa per velocitat en aquest test, ja sabem que el factor està lluny]\n    \n    # F2: Bisecció Resilient\n    m_ini_criba = LIM_CRIBA\n    m_fi_conv = max(m_ini_criba + 1000, int(E_CONV * m_max))\n    \n    if verbose:\n        print(f\"\\n[*] Assaltant N de {len(str(N))} dígits...\")\n        print(f\"[*] Domini m: [{m_ini_criba}, {m_max}]\")\n\n    factor = biseccio_v22(N, m_ini_criba, m_max, verbose=verbose)\n    \n    t_ms = (time.perf_counter() - t0) * 1000\n    return factor, t_ms\n\n# ============================================================================\n#  BATERIA DE PROVES (ELS FOTUTS)\n# ============================================================================\n\ndef executar_tests():\n    casos = [\n        # El cas asimètric 100x209 que va fallar en la v21\n        (,\n         \"RSA-1024 Asimètric (100x209 dígits)\"),\n        \n        # El cas equilibrat 120 dígits\n        ((10**59 + 151) * (10**59 + 719), \"RSA-120 Equilibrat\"),\n    ]\n\n    print(\"\\n\" + \"█\" * 80)\n    print(\"  🚀 MDC v22 — UNITAT D'ASSAUT MILITAR (GOOGLE COLAB)\")\n    print(\"█\" * 80)\n\n    for N, desc in casos:\n        print(f\"\\n📋 TEST: {desc}\")\n        f, t = mdc_v22(N)\n        if f:\n            print(f\"✅ TROBAT en {t/1000:.3f} s\")\n            print(f\"   p = {f}\")\n        else:\n            print(f\"❌ No trobat. Temps: {t/1000:.3f} s\")\n\nif __name__ == \"__main__\":\n    executar_tests()","outputs":[],"execution_count":null,"metadata":{}}],"metadata":{"colab":{"from_bard":true},"kernelspec":{"display_name":"Python 3","name":"python3"}},"nbformat":4,"nbformat_minor":0}